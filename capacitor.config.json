{
  "appId": "com.vibesurvey.app",
  "appName": "VibeSurvey",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0D9488",
      "showSpinner": false
    },
    "Haptics": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#EA580C",
      "sound": "beep.wav"
    }
  }
}
